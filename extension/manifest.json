{
  "manifest_version": 3,
  "name": "Aknan Download",
  "version": "1.0.13",
  "description": "Aknan Download extension.",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "webRequest",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Aknan Download",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n/ar.js",
        "i18n/fr.js",
        "i18n/es.js",
        "i18n/de.js",
        "i18n/pt.js",
        "i18n/tr.js",
        "i18n/ru.js",
        "i18n.js",
        "content/state.js",
        "content/videos.js",
        "content/styles.js",
        "content/bubble-dom.js",
        "content/bubble-actions.js",
        "content/subs-tab.js",
        "content/bubble-render.js",
        "content/clip-tab.js",
        "content/place.js",
        "content/links.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
