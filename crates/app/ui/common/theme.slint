// Global theme palette and shared toolbar tooltip state.
// 0 Light, 1 Dark, 2 Ocean, 3 Midnight ...

export global Theme {
    in-out property <int> mode: 0;
    // themes: Light, Dark, Ocean blue, Midnight purple, Forest green, Black,
    // Sunset, Teal night, Rose, 3D, Aurora glass, Soft clay, Cyber neon
    out property <bool> dark: mode == 1 || mode == 3 || mode == 5 || mode == 7 || mode == 9 || mode == 10 || mode == 12;
    // the 3D looks: raised buttons, rows and lists that float with a shadow
    out property <bool> depth: mode >= 9;
    // which of them: 0 3D, 1 Aurora glass, 2 Soft clay, 3 Cyber neon
    out property <int> look: max(0, mode - 9);
    // the floating cards (a download of the list, a number of the download window)
    out property <color> card-top: [#2c2a4f, #ffffff17, #f5f7fc, #121729][look];
    out property <color> card-bottom: [#252343, #ffffff0a, #eceff6, #0c101e][look];
    out property <color> card-hover-top: [#34325e, #ffffff24, #fbfcff, #182039][look];
    out property <color> card-line: [#35335c, #ffffff21, #ffffff, #1e2747][look];
    out property <color> card-shadow: [#00000066, #00000066, #b9c1d6, #000000d9][look];
    out property <length> card-radius: [10px, 14px, 16px, 8px][look];
    // the chosen one
    out property <color> sel-top: [#4d45b8, #7c5cffaa, #f2efff, #1d1640][look];
    out property <color> sel-bottom: [#3b358f, #2a8fd077, #e4e0ff, #120f28][look];
    out property <color> sel-line: [#7466ff, #b9a4ff, #d2caff, #b84dff][look];
    out property <color> sel-shadow: [#3b33a899, #7c5cff88, #b3a9ef, #b84dffaa][look];
    // the toolbar buttons
    out property <color> btn-top: [#2f2d58, #ffffff1a, #f3f5fa, #141a2e][look];
    out property <color> btn-bottom: [#24223f, #ffffff0a, #e5e9f2, #0b0e1a][look];
    out property <color> btn-line: [#36345f, #ffffff2b, #ffffff, #232c4a][look];
    out property <color> btn-hover-line: [#5a54a8, #ffffff66, #cfc6ff, #00d1ff][look];
    out property <color> btn-shadow: [#0000008c, #00000080, #b3bbd1, #000000][look];
    // the progress bars
    out property <color> bar-a: [#8f7dff, #a78bfa, #8b7bff, #00d1ff][look];
    out property <color> bar-b: [#6c5cff, #38bdf8, #6d5dfc, #00a6ff][look];
    // the colored picture tiles: 0 shiny, 1 outlined and glowing, 2 neon
    out property <int> tile-style: [0, 1, 0, 2][look];
    // Options > General > Text size / Font
    in-out property <float> font-scale: 1.0;
    in-out property <string> font-family: "";
    // a picture behind the main window: how much of it shows through (0..0.8)
    in-out property <float> glass: 0;
    // Arabic: every window reads from right to left
    in-out property <bool> rtl: false;
    // changed by the program to draw a whole window again (Windows may lose
    // what was drawn: shown from next to the clock, the screen woke up...)
    in-out property <int> repaint: 0;
    out property <color> window: window-base;
    out property <color> panel: panel-base.transparentize(glass);
    out property <color> toolbar-top: toolbar-top-base.transparentize(glass);
    out property <color> toolbar-bottom: toolbar-bottom-base.transparentize(glass);
    out property <color> header-top: header-top-base.transparentize(glass);
    out property <color> header-bottom: header-bottom-base.transparentize(glass);
    out property <color> grid: grid-base.transparentize(glass);
    property <color> window-base: [#f0f0f0, #1e1f22, #e8f1fb, #15131d, #eef5ef, #000000, #fbf1ea, #0f1c1e, #fbf0f4, #17162c, #0b0d24, #e9edf6, #05060c][mode];
    property <color> panel-base: [#ffffff, #26282c, #ffffff, #1d1a29, #ffffff, #0b0b0b, #ffffff, #142527, #ffffff, #211f3b, #191c40b3, #eef1f8, #0a0d18][mode];
    property <color> toolbar-top-base: [#fdfdfd, #2e3136, #2f80ed, #2b2545, #2f9e5b, #121212, #f07b3f, #1b3a3d, #e05a8a, #1d1c36, #ffffff0a, #eef1f8, #0c0f1c][mode];
    property <color> toolbar-bottom-base: [#e7ebf0, #24262a, #1b5fc4, #1e1a33, #1f7a43, #050505, #d4513a, #132b2e, #c23d6e, #1a1931, #ffffff05, #e9edf6, #080a14][mode];
    out property <color> toolbar-text: [#1b1f24, #e8eaed, #ffffff, #ece9f6, #ffffff, #f2f2f2, #ffffff, #e3f4f3, #ffffff, #eceaff, #eef0ff, #2b3150, #e7f6ff][mode];
    out property <color> toolbar-hover: [#e5f1fb, #3a3e45, #4a92f0, #3a3260, #45b06f, #262626, #f5955f, #26504f, #e97aa1, #34315e, #ffffff1c, #e1e6f2, #141b30][mode];
    out property <color> line: [#d9dde3, #3a3d42, #c6d8ef, #352f4d, #c9dfcf, #262626, #efd2c2, #24403f, #efcdda, #34325a, #ffffff24, #d5dbe8, #1e2747][mode];
    property <color> grid-base: [#eef0f3, #2f3237, #eaf2fc, #26223a, #eaf4ec, #141414, #fbeee6, #1a2e30, #fbedf2, #29274a, #ffffff10, #e4e8f2, #10162a][mode];
    property <color> header-top-base: [#ffffff, #2e3136, #f7fbff, #26223a, #f8fcf9, #161616, #fffaf6, #1b3133, #fffafc, #211f3b, #ffffff0d, #eef1f8, #0e1222][mode];
    property <color> header-bottom-base: [#eef1f5, #282a2e, #e3eefb, #201c31, #e2f0e6, #0e0e0e, #f8e5d9, #16292b, #f8e3eb, #1e1c37, #ffffff07, #e8ecf5, #0a0d18][mode];
    out property <color> text: [#1b1f24, #e8eaed, #13243a, #ece9f6, #15281b, #f2f2f2, #2e1a12, #e3f4f3, #2e1420, #ecebf8, #eef0ff, #2b3150, #e7f6ff][mode];
    out property <color> muted: [#5f6b78, #9aa0a6, #557090, #a59fc0, #557a61, #9a9a9a, #8a6352, #8fb3b0, #8a5a6c, #a09dc6, #9aa3c7, #7b83a3, #7f8fb5][mode];
    out property <color> accent: [#1f6feb, #5b9dff, #1565c0, #a78bfa, #1f8a4c, #4ea1ff, #d4513a, #2ec4b6, #c23d6e, #7466ff, #a78bfa, #6d5dfc, #00d1ff][mode];
    out property <color> select: [#cce8ff, #264f78, #cfe4ff, #3d3366, #cdebd7, #1f3550, #fbd9c8, #1d4b4b, #f8d3e1, #4a41b8, #7c5cff66, #e4e0ff, #1a1438][mode];
    out property <color> select-line: [#99d1ff, #3a6ea5, #8dbcf5, #5b4a99, #8ccaa2, #2f5a8a, #eea98a, #2b7470, #eaa0bb, #7466ff, #a78bfa, #b9b0f0, #b84dff][mode];
    out property <color> hover: [#e5f3ff, #2c3440, #e3efff, #2a2541, #e2f3e7, #1a1a1a, #fdeadf, #1b3436, #fde6ee, #2d2b52, #ffffff14, #e6e9f4, #111628][mode];
    out property <color> ok: dark ? #3fcf7a : #1f9d55;
    out property <color> warn: #e08a00;
    out property <color> err: dark ? #ff6b62 : #d23b32;
    out property <color> bar-bg: depth ? [#12112a, #ffffff17, #dde2ee, #161c33][look] : dark ? #34373c : #e6e6e6;
    out property <color> input-bg: dark ? #2b2d31 : #ffffff;
}

// The note under a toolbar button the mouse rests on (one per window).
export global ToolTip {
    in-out property <string> title;
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    // the mouse is on a button (the note shows after a moment)
    in-out property <bool> pending;
    in-out property <bool> shown;
}
