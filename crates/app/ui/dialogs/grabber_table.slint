// Checkable link results table for GrabberDialog.

import { ListView } from "std-widgets.slint";
import { LinkRow, Theme, TypeIcon, HeaderCell, Cell, Glyph, HRow } from "../common.slint";

export component GrabberLinksBox inherits Rectangle {
    in property <[LinkRow]> links;
    in property <bool> links-mode;
    in property <bool> exploring;
    callback toggle(int);

    vertical-stretch: 1;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 1px;
        Rectangle {
            height: 22px;
            background: @linear-gradient(180deg, Theme.header-top 0%, Theme.header-bottom 100%);
            HRow {
                HeaderCell {
                    text: "";
                    width: 54px;
                }
                HeaderCell {
                    text: @tr("File name");
                    width: 260px;
                }
                HeaderCell {
                    text: @tr("Type");
                    width: 60px;
                }
                HeaderCell {
                    text: @tr("Link text");
                    width: 170px;
                }
                HeaderCell {
                    text: @tr("Address");
                    horizontal-stretch: 1;
                }
            }
        }
        ListView {
            vertical-stretch: 1;
            for l[i] in root.links: Rectangle {
                height: 22px;
                background: la.has-hover ? Theme.hover : transparent;
                la := TouchArea {
                    clicked => {
                        root.toggle(i);
                    }
                }
                HRow {
                    padding-left: Theme.rtl ? (0px) : (6px);
                    padding-right: Theme.rtl ? (6px) : (0px);
                    spacing: 4px;
                    Rectangle {
                        width: 24px;
                        Rectangle {
                            y: (parent.height - 14px) / 2;
                            width: 14px;
                            height: 14px;
                            border-width: 1px;
                            border-radius: 2px;
                            border-color: l.checked ? Theme.accent : Theme.muted;
                            background: l.checked ? Theme.accent : Theme.input-bg;
                            if l.checked: Glyph {
                                x: 1px;
                                y: 1px;
                                width: 12px;
                                height: 12px;
                                kind: "check";
                                tint: white;
                            }
                        }
                    }
                    Rectangle {
                        width: 20px;
                        TypeIcon {
                            kind: l.kind;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                        }
                    }
                    Cell {
                        text: l.name;
                        horizontal-alignment: l.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        width: 256px;
                    }
                    Cell {
                        text: l.ext;
                        width: 56px;
                        color: Theme.muted;
                    }
                    Cell {
                        text: l.text;
                        width: 166px;
                        color: Theme.muted;
                    }
                    Cell {
                        text: l.url;
                        horizontal-stretch: 1;
                        color: Theme.accent;
                        font-size: 11px * Theme.font-scale;
                    }
                }
            }
        }
    }
    if root.links.length == 0: Text {
        y: 80px;
        width: parent.width;
        horizontal-alignment: center;
        text: root.links-mode ? @tr("No links on this page.") : root.exploring ? @tr("Exploring…") : @tr("Type a start page and click \"Start exploring\".");
        color: Theme.muted;
    }
}
