// Small reusable dialog primitives: labels, hints, sections, radios and tab buttons.

import { Theme } from "../common.slint";

export component Label inherits Text {
    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    vertical-alignment: center;
    color: Theme.text;
    font-size: 12px * Theme.font-scale;
}

export component Hint inherits Text {
    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    color: Theme.muted;
    font-size: 11px * Theme.font-scale;
    wrap: word-wrap;
}

export component Section inherits Text {
    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    color: Theme.accent;
    font-size: 12px * Theme.font-scale;
    font-weight: 700;
}

// a round option button (one of several)
export component Radio inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    height: 22px;
    min-width: lbl.preferred-width + 24px;
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    Rectangle {
        x: Theme.rtl ? parent.width - 14px : 0;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.checked ? Theme.accent : Theme.muted;
        background: Theme.input-bg;
        if root.checked: Rectangle {
            x: 3.5px;
            y: 3.5px;
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: Theme.accent;
        }
    }
    lbl := Text {
        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        x: Theme.rtl ? 0px : 20px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        color: root.enabled ? Theme.text : Theme.muted;
    }
}

// vertical tab list on the left of the Options window
export component SideTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 28px;
    background: root.active ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.select-line;
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Text {
        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        font-weight: root.active ? 600 : 400;
        color: Theme.text;
    }
}

// horizontal tab button (Scheduler)
export component TabBtn inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 26px;
    width: tl.preferred-width + 24px;
    background: root.active ? Theme.panel : ta.has-hover ? Theme.hover : Theme.window;
    border-width: 1px;
    border-color: Theme.line;
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    tl := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        font-weight: root.active ? 600 : 400;
        color: Theme.text;
    }
}

// horizontal tab button with bottom seam overlap (Batch / Details)
export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 26px;
    width: label.preferred-width + 24px;
    background: root.active ? Theme.panel : ta.has-hover ? Theme.hover : Theme.window;
    border-width: 1px;
    border-color: Theme.line;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        font-weight: root.active ? 600 : 400;
        color: Theme.text;
    }
    if root.active: Rectangle {
        x: 1px;
        y: parent.height - 1px;
        width: parent.width - 2px;
        height: 2px;
        background: Theme.panel;
    }
}
