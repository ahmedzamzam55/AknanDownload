// Video entries table for PlaylistDialog.

import { ListView } from "std-widgets.slint";
import { LinkRow, Theme, HeaderCell, Cell, Glyph, HRow } from "../common.slint";

export component PlaylistEntriesBox inherits Rectangle {
    in property <[LinkRow]> entries;
    in property <bool> busy;
    callback toggle(int);
    vertical-stretch: 1;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 1px;
        Rectangle {
            height: 22px;
            background: @linear-gradient(180deg, Theme.header-top 0%, Theme.header-bottom 100%);
            HRow {
                HeaderCell {
                    text: "";
                    width: 34px;
                }
                HeaderCell {
                    text: "#";
                    width: 40px;
                }
                HeaderCell {
                    text: @tr("Video");
                    horizontal-stretch: 1;
                }
                HeaderCell {
                    text: @tr("Length");
                    width: 80px;
                }
            }
        }
        ListView {
            vertical-stretch: 1;
            for e[i] in root.entries: Rectangle {
                height: 24px;
                background: ea.has-hover ? Theme.hover : transparent;
                ea := TouchArea {
                    clicked => {
                        root.toggle(i);
                    }
                }
                HRow {
                    padding-left: Theme.rtl ? (0px) : (8px);
                    padding-right: Theme.rtl ? (8px) : (0px);
                    spacing: 4px;
                    Rectangle {
                        width: 26px;
                        Rectangle {
                            y: (parent.height - 14px) / 2;
                            width: 14px;
                            height: 14px;
                            border-width: 1px;
                            border-radius: 2px;
                            border-color: e.checked ? Theme.accent : Theme.muted;
                            background: e.checked ? Theme.accent : Theme.input-bg;
                            if e.checked: Glyph {
                                x: 1px;
                                y: 1px;
                                width: 12px;
                                height: 12px;
                                kind: "check";
                                tint: white;
                            }
                        }
                    }
                    Cell {
                        text: e.text;
                        width: 36px;
                        color: Theme.muted;
                    }
                    Cell {
                        text: e.name;
                        horizontal-alignment: e.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        horizontal-stretch: 1;
                    }
                    Cell {
                        text: e.ext;
                        width: 76px;
                        color: Theme.muted;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
                    }
                }
            }
        }
    }
    if root.entries.length == 0: Text {
        y: 70px;
        width: parent.width;
        horizontal-alignment: center;
        text: root.busy ? @tr("Getting the videos of the playlist…") : @tr("The videos of the playlist show up here.");
        color: Theme.muted;
    }
}
