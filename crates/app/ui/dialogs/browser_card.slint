// Browser row data and clickable browser card for BrowserDialog.

import { Theme, Glyph, HRow } from "../common.slint";

export struct BrowserRow {
    name: string,
    // accent color of its card
    tint: color,
    installed: bool,
    // "Add from the store" / "Add (developer mode)"
    action: string,
}

export component BrowserCard inherits Rectangle {
    in property <BrowserRow> data;
    callback add();
    height: 150px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ta.has-hover ? root.data.tint : Theme.line;
    background: ta.has-hover ? Theme.hover : Theme.panel;
    opacity: root.data.installed ? 1.0 : 0.55;
    ta := TouchArea {
        clicked => {
            root.add();
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        alignment: center;
        HRow {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 26px;
                background: @linear-gradient(135deg, root.data.tint 0%, root.data.tint.darker(40%) 100%);
                // a globe: the browser
                Path {
                    x: 10px;
                    y: 10px;
                    width: 32px;
                    height: 32px;
                    viewbox-width: 32;
                    viewbox-height: 32;
                    stroke: white;
                    stroke-width: 1.6px;
                    fill: transparent;
                    commands: "M 16 3 A 13 13 0 1 1 15.99 3 Z M 3 16 L 29 16 M 16 3 C 9 9 9 23 16 29 M 16 3 C 23 9 23 23 16 29";
                }
                Rectangle {
                    x: 34px;
                    y: 34px;
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: #2e9e4f;
                    border-width: 2px;
                    border-color: Theme.panel;
                    Glyph {
                        x: 2px;
                        y: 2px;
                        kind: "down";
                        tint: white;
                    }
                }
            }
        }
        Text {
            text: root.data.name;
            horizontal-alignment: center;
            font-size: 14px * Theme.font-scale;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: root.data.installed ? root.data.action : @tr("Not installed on this computer");
            horizontal-alignment: center;
            font-size: 11px * Theme.font-scale;
            color: root.data.installed ? Theme.accent : Theme.muted;
            wrap: word-wrap;
        }
    }
}
