// Help > Check for updates dialog.

import { Button } from "std-widgets.slint";
import { Theme, ThemedWindow, Glyph, HRow } from "../common.slint";

export component UpdateDialog inherits ThemedWindow {
    forward-focus: dlg-keys;
    public function focus-input() {
        dlg-keys.focus();
    }
    // set for a moment so the window comes in front
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Check for updates");
    preferred-width: 460px;
    // 0 checking, 1 newest already, 2 downloading, 3 installing, 4 problem
    in property <int> state;
    in property <string> heading;
    in property <string> detail;
    // 0..1 while downloading (-1 = size unknown)
    in property <float> progress: -1;
    callback close-window();
    dlg-keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape && root.state != 3) {
                root.close-window();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 18px;
            spacing: 12px;
            GridLayout {
                // a row that reads from right to left in Arabic (wrapped text needs a grid)
                spacing: 14px;
                Rectangle {
                    col: Theme.rtl ? 1 : 0;
                    row: 0;
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: root.state == 1 ? Theme.ok : root.state == 4 ? Theme.err : Theme.accent;
                    Glyph {
                        x: 14px;
                        y: 14px;
                        kind: root.state == 1 ? "check" : root.state == 4 ? "warn" : "down";
                        tint: white;
                    }
                }
                VerticalLayout {
                    col: Theme.rtl ? 0 : 1;
                    row: 0;
                    alignment: center;
                    spacing: 4px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.heading;
                        font-size: 14px * Theme.font-scale;
                        font-weight: 700;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.detail;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                }
            }
            if root.state == 0 || root.state == 2 || root.state == 3: Rectangle {
                height: 10px;
                border-radius: 5px;
                background: Theme.bar-bg;
                clip: true;
                // known size: how far it is; otherwise a moving piece
                if root.state == 2 && root.progress >= 0: Rectangle {
                    x: Theme.rtl ? parent.width - self.width : 0;
                    width: parent.width * clamp(root.progress, 0, 1);
                    height: parent.height;
                    border-radius: 5px;
                    background: Theme.accent;
                    animate width { duration: 150ms; }
                }
                if !(root.state == 2 && root.progress >= 0): Rectangle {
                    width: parent.width * 0.3;
                    height: parent.height;
                    border-radius: 5px;
                    background: Theme.accent;
                    x: mod(animation-tick() / 1ms, 1600) / 1600 * (parent.width * 1.3) - parent.width * 0.3;
                }
            }
            HRow {
                alignment: end;
                Button {
                    text: root.state == 2 || root.state == 3 ? @tr("Hide") : @tr("Close");
                    primary: root.state == 1 || root.state == 4;
                    enabled: root.state != 3;
                    clicked => {
                        root.close-window();
                    }
                }
            }
        }
    }
}
