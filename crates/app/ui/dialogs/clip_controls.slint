// Time range, cut mode and action buttons for ClipDialog.

import { Button, LineEdit, ComboBox, Slider } from "std-widgets.slint";
import { Theme, HRow } from "../common.slint";
import { Label } from "widgets.slint";

export component ClipControls inherits VerticalLayout {
    in property <length> label-w: 90px;
    in property <bool> ready;
    in property <float> duration;
    in-out property <float> from;
    in-out property <float> to;
    in-out property <string> from-text;
    in-out property <string> to-text;
    in property <string> length-text;
    in-out property <int> cut;
    in property <bool> previewing;
    in property <string> message;
    callback from-typed(string);
    callback to-typed(string);
    callback slid();
    callback preview();
    callback download();
    callback close-window();

    spacing: 8px;
    HRow {
        spacing: 8px;
        Label {
            width: root.label-w;
            text: @tr("From:");
            vertical-alignment: center;
        }
        LineEdit {
            width: 100px;
            enabled: root.ready;
            text <=> root.from-text;
            placeholder-text: "00:00";
            edited(t) => {
                root.from-typed(t);
            }
        }
        Slider {
            horizontal-stretch: 1;
            enabled: root.ready && root.duration > 0;
            minimum: 0;
            maximum: max(root.duration, 1);
            value <=> root.from;
            changed(v) => {
                root.slid();
            }
        }
    }
    HRow {
        spacing: 8px;
        Label {
            width: root.label-w;
            text: @tr("To:");
            vertical-alignment: center;
        }
        LineEdit {
            width: 100px;
            enabled: root.ready;
            text <=> root.to-text;
            placeholder-text: "00:30";
            edited(t) => {
                root.to-typed(t);
            }
        }
        Slider {
            horizontal-stretch: 1;
            enabled: root.ready && root.duration > 0;
            minimum: 0;
            maximum: max(root.duration, 1);
            value <=> root.to;
            changed(v) => {
                root.slid();
            }
        }
    }
    HRow {
        spacing: 8px;
        Label {
            width: root.label-w;
            text: @tr("Length:");
            vertical-alignment: center;
        }
        Text {
            vertical-alignment: center;
            text: root.length-text;
            color: Theme.text;
            font-weight: 700;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
    HRow {
        spacing: 8px;
        Label {
            width: root.label-w;
            text: @tr("Cut:");
            vertical-alignment: center;
        }
        ComboBox {
            horizontal-stretch: 1;
            enabled: root.ready;
            model: [@tr("Quick cut (recommended)"), @tr("Exact cut")];
            current-index <=> root.cut;
        }
    }
    // what each kind of cut does
    Rectangle {
        background: Theme.input-bg;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 4px;
        VerticalLayout {
            padding: 10px;
            spacing: 4px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.cut == 0 ? @tr("Quick cut") : @tr("Exact cut");
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                wrap: word-wrap;
                color: Theme.text;
                font-size: 12px * Theme.font-scale;
                text: root.cut == 0
                    ? @tr("Takes seconds and keeps the quality exactly as it is (nothing is made again). A video can only start on a whole picture, so the part may start a second or two before the time you chose.")
                    : @tr("Starts and ends on the very second you chose. The picture of the part is made again, so it takes longer (about as long as the part plays, or less) and works the processor. Sound alone is always cut exactly.");
            }
        }
    }
    if root.message != "": Text {
        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: root.message;
        wrap: word-wrap;
        color: #e0443b;
    }
    HRow {
        spacing: 8px;
        Button {
            text: root.previewing ? @tr("Preparing the preview…") : @tr("Preview the part");
            enabled: root.ready && !root.previewing;
            clicked => {
                root.preview();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Button {
            text: @tr("Download the part");
            primary: true;
            enabled: root.ready;
            clicked => {
                root.download();
            }
        }
        Button {
            text: @tr("Close");
            clicked => {
                root.close-window();
            }
        }
    }
}
