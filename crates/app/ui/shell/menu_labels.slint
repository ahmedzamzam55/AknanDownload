// Translated menu bar and menu item labels exported for native RTL/LTR popup menus.

export global MenuLabels {
    out property <string> tasks: @tr("Tasks");
    out property <string> file: @tr("File");
    out property <string> downloads: @tr("Downloads");
    out property <string> view: @tr("View");
    out property <string> help: @tr("Help");

    out property <string> export-menu: @tr("Export");
    out property <string> import-menu: @tr("Import");

    out property <string> select-all: @tr("Select all   Ctrl+A");
    out property <string> properties: @tr("Properties");

    out property <string> start-queue: @tr("Start queue");
    out property <string> stop-queue: @tr("Stop queue");
    out property <string> speed-limiter: @tr("Speed Limiter");
    out property <string> turn-on: @tr("Turn on");
    out property <string> turn-off: @tr("Turn off");
    out property <string> settings: @tr("Settings…");
    out property <string> when-all-done: @tr("When all downloads finish");
    out property <string> scheduler: @tr("Scheduler…");
    out property <string> options: @tr("Options…");

    out property <string> show-categories: @tr("Show categories");
    out property <string> arrange-files: @tr("Arrange files");
    out property <string> toolbar: @tr("Toolbar");
    out property <string> large-buttons: @tr("Large buttons");
    out property <string> small-buttons: @tr("Small buttons");
    out property <string> columns: @tr("Columns…");
    out property <string> language: @tr("Language");
    out property <string> theme: @tr("Theme");
    out property <string> appearance: @tr("Appearance…");

    out property <string> about: @tr("About Aknan Download");
}
