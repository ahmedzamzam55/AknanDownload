// Main toolbar with large/small buttons, separators and filter box.

import { Theme, ToolBtn, ToolSeparator, HRow } from "../common.slint";
import { ToolbarSearch } from "toolbar_search.slint";

export component Toolbar inherits Rectangle {
    in property <bool> toolbar-small;
    in property <bool> can-resume;
    in property <bool> can-stop;
    in property <int> selected-id: -1;
    in property <bool> limiter-on;
    in-out property <string> search;
    callback act(string);
    callback open-queue-menu(bool, length);
    callback search-changed();
    callback focus-main();

    public function focus-search() {
        search-box.focus-search();
    }

    // 13 + 2 wider buttons, 5 lines between them, the filter box
    property <length> full-need: 13 * max(56px, 56px * Theme.font-scale) + 2 * max(62px, 62px * Theme.font-scale) + 5 * 7px + 14px + 96px + 16px;
    property <length> small-need: 15 * 34px + 5 * 7px + 14px + 96px + 16px;
    // only with bigger text (at the usual size the last buttons
    // are cut in a narrow window, as before)
    property <bool> small-now: root.toolbar-small || (Theme.font-scale > 1.05 && self.width < self.full-need);
    // bigger text (Options > Appearance): a taller bar, the names are never cut
    height: root.small-now ? 42px : max(64px, 38px + 26px * Theme.font-scale);
    min-width: 0px;
    clip: true;
    background: @linear-gradient(180deg, Theme.toolbar-top 0%, Theme.toolbar-bottom 100%);
    HRow {
        width: max(parent.width, root.small-now ? root.small-need : root.full-need);
        x: Theme.rtl ? parent.width - self.width : 0;
        padding: 4px;
        padding-left: Theme.rtl ? (10px) : (6px);
        padding-right: Theme.rtl ? (6px) : (10px);
        spacing: 1px;
        ToolBtn {
            icon: "add";
            text: @tr("Add URL");
            small: root.small-now;
            clicked => { root.act("add-url"); }
        }
        ToolBtn {
            icon: "batch";
            text: @tr("Add Batch");
            small: root.small-now;
            clicked => { root.act("add-batch"); }
        }
        ToolSeparator { }
        ToolBtn {
            icon: "resume";
            text: @tr("Resume");
            small: root.small-now;
            enabled: root.can-resume;
            clicked => { root.act("resume"); }
        }
        ToolBtn {
            icon: "stop";
            text: @tr("Stop");
            small: root.small-now;
            enabled: root.can-stop;
            clicked => { root.act("pause"); }
        }
        ToolBtn {
            icon: "stopall";
            text: @tr("Stop All");
            small: root.small-now;
            clicked => { root.act("stop-all"); }
        }
        ToolSeparator { }
        ToolBtn {
            icon: "delete";
            text: @tr("Delete");
            small: root.small-now;
            enabled: root.selected-id >= 0;
            clicked => { root.act("delete"); }
        }
        ToolBtn {
            icon: "deletedone";
            text: @tr("Delete Done");
            small: root.small-now;
            clicked => { root.act("delete-completed"); }
        }
        ToolSeparator { }
        ToolBtn {
            icon: "options";
            text: @tr("Options");
            small: root.small-now;
            clicked => { root.act("open-settings"); }
        }
        ToolBtn {
            icon: "scheduler";
            text: @tr("Scheduler");
            small: root.small-now;
            clicked => { root.act("open-scheduler"); }
        }
        ToolBtn {
            icon: "limiter";
            text: root.limiter-on ? @tr("Limiter: On") : @tr("Limiter: Off");
            small: root.small-now;
            clicked => { root.act("toggle-limiter"); }
        }
        ToolSeparator { }
        start-q := ToolBtn {
            icon: "startqueue";
            text: @tr("Start Queue");
            small: root.small-now;
            width: root.small-now ? 34px : max(62px, 62px * Theme.font-scale);
            clicked => {
                root.open-queue-menu(true, self.absolute-position.x);
            }
        }
        stop-q := ToolBtn {
            icon: "stopqueue";
            text: @tr("Stop Queue");
            small: root.small-now;
            width: root.small-now ? 34px : max(62px, 62px * Theme.font-scale);
            clicked => {
                root.open-queue-menu(false, self.absolute-position.x);
            }
        }
        ToolSeparator { }
        ToolBtn {
            icon: "grabber";
            text: @tr("Grabber");
            small: root.small-now;
            clicked => { root.act("grabber"); }
        }
        ToolBtn {
            icon: "playlist";
            text: @tr("Playlist");
            small: root.small-now;
            clicked => { root.act("playlist"); }
        }
        ToolBtn {
            icon: "torrent";
            text: @tr("Torrent");
            small: root.small-now;
            clicked => { root.act("torrent"); }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        search-box := ToolbarSearch {
            search <=> root.search;
            search-changed => { root.search-changed(); }
            act(c) => { root.act(c); }
            focus-main => { root.focus-main(); }
        }
    }
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.line;
    }
}
