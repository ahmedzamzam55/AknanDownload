// Aknan Download – user interface (Slint) entry module.

import { DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme, ThemedWindow } from "common.slint";
export { DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme }
export { BrowserRow, ConfirmDialog, ColumnsDialog, CategoryDialog, FindDialog, PropertiesDialog, DuplicateDialog, CountdownDialog, SchedulerDialog, GrabberDialog, TipDialog, RefreshDialog, SettingsDialog, PlaylistDialog, TorrentDialog, BrowserDialog, AboutDialog, UpdateDialog, WhatsNewDialog, ClipDialog, AddDialog, BatchDialog, DetailsDialog, CompleteDialog } from "dialogs.slint";
export { MenuData, MenuAction, MenuKeyTitle, MenuNumTitle } from "shell/menu_data.slint";
export { MenuLabels } from "shell/menu_labels.slint";
import { ToolTipOverlay } from "shell/status_bar.slint";
import { MainBody } from "shell/main_body.slint";

export component MainWindow inherits ThemedWindow {
    forward-focus: body;
    public function focus-list() { body.focus(); }
    in property <bool> front;
    always-on-top: root.front;
    in property <string> app-version;
    title: @tr("Aknan Download") + (root.app-version == "" ? "" : " " + root.app-version);
    in property <image> bg-image;
    in property <bool> has-bg-image;
    preferred-width: 960px; preferred-height: 500px; min-width: 700px; min-height: 380px;

    in property <[DownloadRow]> rows;
    in property <[QueueRow]> queues;
    in property <[CatRow]> categories;
    in property <string> count-all;
    in property <string> count-unfinished;
    in property <string> count-finished;
    in-out property <int> selected-id: -1;
    in-out property <string> view: "all";
    in-out property <string> search;
    in property <string> status-text;
    in property <string> limiter-text;
    in property <int> selected-state: -1;
    in property <int> sel-count;
    in property <bool> can-resume;
    in property <bool> can-stop;
    in property <int> current-queue: 1;
    in property <bool> limiter-on;
    in property <bool> hide-categories;
    in property <string> sort-by: "date";
    in property <bool> sort-desc: true;
    in property <int> all-done: 0;
    in property <Cols> cols: { q: true, size: true, status: true, eta: true, speed: true, last: true, desc: true };
    in property <bool> toolbar-small;
    in property <string> language: "en";
    in-out property <bool> open-all: true;
    in-out property <bool> open-unf: false;
    in-out property <bool> open-fin: false;
    in-out property <bool> open-queues: true;
    in property <bool> native-menu;
    in property <[ColDef]> columns;
    in-out property <int> active-menu: -1;

    callback add-url();
    callback add-batch();
    callback add-batch-clipboard();
    callback resume(int);
    callback pause(int);
    callback resume-all();
    callback stop-all();
    callback delete(int);
    callback delete-completed();
    callback open-settings(int);
    callback open-scheduler();
    callback open-limiter();
    callback toggle-limiter();
    callback start-queue(int);
    callback stop-queue(int);
    callback new-queue();
    callback edit-queue(int);
    callback delete-queue(int);
    callback view-changed(string);
    callback search-changed();
    callback sort(string);
    callback row-activated(int);
    callback row-clicked(int, bool, bool);
    callback row-right(int);
    callback row-menu(int);
    callback row-drag(int, int);
    callback row-drag-out(int);
    callback column-resized(int, length);
    callback column-dropped(int, length);
    callback columns-changed();
    callback select-all();
    callback paste-url();
    callback refresh-list();
    callback row-action(int, string);
    callback move-selection(int, bool);
    callback show-shortcuts();
    callback row-to-queue(int, int);
    callback open-download-folder();
    callback export-list(string);
    callback import-list(string);
    callback set-theme(int);
    callback set-language(string);
    callback toggle-categories();
    callback set-toolbar-small(bool);
    callback open-columns();
    callback update-tools();
    callback check-app-update();
    callback set-all-done(int);
    callback add-category();
    callback category-props(string);
    callback delete-category(string);
    callback find();
    callback find-next();
    callback grabber();
    callback playlist();
    callback clip-part();
    callback torrent();
    callback browsers();
    callback tips();
    callback about();
    callback quit();
    callback open-top-menu(int, float, float);

    public function act(c: string) {
        if (c == "add-url") { root.add-url(); return; } if (c == "add-batch") { root.add-batch(); return; }
        if (c == "add-batch-clipboard") { root.add-batch-clipboard(); return; } if (c == "grabber") { root.grabber(); return; }
        if (c == "playlist") { root.playlist(); return; } if (c == "clip-part") { root.clip-part(); return; }
        if (c == "torrent") { root.torrent(); return; } if (c == "open-download-folder") { root.open-download-folder(); return; }
        if (c == "quit") { root.quit(); return; } if (c == "resume") { root.resume(root.selected-id); return; }
        if (c == "pause") { root.pause(root.selected-id); return; } if (c == "delete") { root.delete(root.selected-id); return; }
        if (c == "resume-all") { root.resume-all(); return; } if (c == "stop-all") { root.stop-all(); return; }
        if (c == "delete-completed") { root.delete-completed(); return; } if (c == "open-settings") { root.open-settings(0); return; }
        if (c == "open-scheduler") { root.open-scheduler(); return; } if (c == "toggle-limiter") { root.toggle-limiter(); return; }
        if (c == "find") { root.find(); return; } if (c == "find-next") { root.find-next(); return; }
        if (c == "select-all") { root.select-all(); return; } if (c == "paste-url") { root.paste-url(); return; }
        if (c == "refresh-list") { root.refresh-list(); return; } if (c == "show-shortcuts") { root.show-shortcuts(); return; }
        if (c == "browsers") { root.browsers(); return; } if (c == "tips") { root.tips(); return; }
        if (c == "check-app-update") { root.check-app-update(); return; } if (c == "update-tools") { root.update-tools(); return; }
        if (c == "search-changed") { root.search-changed(); return; } if (c == "columns-changed") { root.columns-changed(); return; }
        if (c == "new-queue") { root.new-queue(); return; } if (c == "add-category") { root.add-category(); return; }
    }
    function int-act(c: string, a: int) {
        if (c == "start-queue") { root.start-queue(a); return; } if (c == "stop-queue") { root.stop-queue(a); return; }
        if (c == "edit-queue") { root.edit-queue(a); return; } if (c == "delete-queue") { root.delete-queue(a); return; }
        if (c == "row-activated") { root.row-activated(a); return; } if (c == "row-right") { root.row-right(a); return; }
        if (c == "row-menu") { root.row-menu(a); return; } if (c == "row-drag-out") { root.row-drag-out(a); return; }
    }
    function str-act(c: string, s: string) {
        if (c == "view-changed") { root.view-changed(s); return; } if (c == "sort") { root.sort(s); return; }
        if (c == "category-props") { root.category-props(s); return; } if (c == "delete-category") { root.delete-category(s); return; }
    }
    function int2-act(c: string, a: int, b: int) {
        if (c == "row-drag") { root.row-drag(a, b); return; } if (c == "row-to-queue") { root.row-to-queue(a, b); return; }
    }

    if root.has-bg-image: Image { x: 0; y: 0; width: root.width; height: root.height; source: root.bg-image; image-fit: cover; }
    body := MainBody {
        width: 100%; height: 100%;
        active-menu: root.active-menu;
        state: {
            selected-id: root.selected-id, selected-state: root.selected-state, sel-count: root.sel-count,
            can-resume: root.can-resume, can-stop: root.can-stop, current-queue: root.current-queue,
            limiter-on: root.limiter-on, hide-categories: root.hide-categories, sort-by: root.sort-by,
            sort-desc: root.sort-desc, toolbar-small: root.toolbar-small, native-menu: root.native-menu,
            count-all: root.count-all, count-unfinished: root.count-unfinished, count-finished: root.count-finished,
            status-text: root.status-text, limiter-text: root.limiter-text,
        };
        rows: root.rows; queues: root.queues; categories: root.categories; cols: root.cols; columns: root.columns;
        view <=> root.view; search <=> root.search;
        open-all <=> root.open-all; open-unf <=> root.open-unf; open-fin <=> root.open-fin; open-queues <=> root.open-queues;
        act(c) => { root.act(c); } int-act(c, a) => { root.int-act(c, a); } str-act(c, s) => { root.str-act(c, s); } int2-act(c, a, b) => { root.int2-act(c, a, b); }
        open-top-menu(i, x, y) => { root.open-top-menu(i, x / 1px, y / 1px); }
        move-selection(d, s) => { root.move-selection(d, s); } row-clicked(id, c, s) => { root.row-clicked(id, c, s); }
        row-action(id, a) => { root.row-action(id, a); } column-resized(i, w) => { root.column-resized(i, w); } column-dropped(i, x) => { root.column-dropped(i, x); }
    }
    ToolTipOverlay { }
}
